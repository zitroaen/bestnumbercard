{
  "name": "best-number-card",
  "version": "0.5.0",
  "description": "A Home Assistant dashboard card like the built-in sensor card, but for multiple entities, with per-series color scales and efficient data loading.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "typecheck": "tsc --noEmit",
